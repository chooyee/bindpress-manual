{
  "name": "@bindpress/manual",
  "version": "0.1.0",
  "description": "Render a user manual or FAQ, written as one JSON document, to safe HTML: a PDF-style paged reader for manuals and a searchable help centre for FAQs. No dependencies, no build step, works under a strict CSP.",
  "keywords": [
    "manual",
    "user-guide",
    "faq",
    "help-centre",
    "documentation",
    "renderer",
    "json",
    "server-side-rendering",
    "vanilla-js",
    "no-dependencies"
  ],
  "license": "MIT",
  "author": "Lee Choo Yee",
  "homepage": "https://chooyee.github.io/bindpress-manual/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chooyee/bindpress-manual.git"
  },
  "bugs": {
    "url": "https://github.com/chooyee/bindpress-manual/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "unpkg": "./dist/bindpress-manual.min.js",
  "jsdelivr": "./dist/bindpress-manual.min.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./reader": {
      "types": "./types/reader.d.ts",
      "default": "./src/reader.js"
    },
    "./manual.css": "./src/manual.css",
    "./schema.json": "./schema/manual.schema.json",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "types",
    "schema",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "test": "node --test",
    "test:browser": "node scripts/browser-check.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "types": "tsc -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "docs": "node scripts/serve.mjs",
    "example": "node examples/server-render.mjs",
    "prepack": "npm run types && npm run build",
    "prepublishOnly": "npm test && npm run typecheck"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  }
}
